;; What this vertical's robot physically does, declared for
;; kotoba.robotics.process (kotoba-lang/robotics). `kbb -M:physics` runs it.
;;
;; README: web technicians (ISCO 3514) are a Wave-0 cognitive occupation (no
;; robotics gate); blueprint.edn declares :itonami.blueprint/robotics true.
;; The physical edge of web technician work is the device lab: placing test
;; phones into a test cradle and carrying device trays between the lab and
;; the charging cabinet. These cases declare that edge.
;;
;; Every number without a cited source is marked `estimate` in its :basis.
{:physics/schema "itonami.physical-ai.spec.v1"
 :repo "cloud-itonami/cloud-itonami-isco-3514"
 :cases
 [{:id :phone-into-test-cradle
   :kind :manipulator
   :procedure "desktop arm moves a test phone from the device rack into the browser-test cradle; faster moves shorten the test cycle"
   :params {:l1-m 0.30 :l2-m 0.25 :m1-kg 1.5 :m2-kg 1.0 :payload-kg 0.25
            :from [0.40 0.05] :to [0.15 0.40] :steps 300}
   :sweep {:param :duration-s :values [0.25 0.4 0.6 1.0 2.0]}
   :quantity :peak-tau1-nm
   :limit {:max 15.0 :basis "estimate: continuous shoulder torque of a desktop arm (~1-3 kg class)"}
   :boundary {:lo 0.05 :hi 3.0}}
  {:id :device-tray-to-charging-cabinet
   :kind :transport
   :procedure "robot carries a tray of test devices from the device lab to the charging cabinet"
   :params {:mass-kg 40.0 :payload-kg 6.0 :v-max-mps 1.0 :a-max-mps2 0.5
            :brake-decel-mps2 0.8 :drive-force-n 80.0 :crr 0.02
            :cog-height-m 0.55 :support-half-length-m 0.25}
   :sweep {:param :distance-m :values [10.0 25.0 50.0 80.0 120.0]}
   :quantity :cycle-time-s
   :limit {:max 60.0 :basis "estimate: device swap between test runs should take under a minute so the lab queue does not stall"}
   :boundary {:lo 2.0 :hi 400.0}}]}
