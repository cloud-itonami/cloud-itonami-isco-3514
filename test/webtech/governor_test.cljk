(ns webtech.governor-test
  (:require [kotoba.test :refer [deftest is testing]]
            [webtech.store :as store]
            [webtech.governor :as governor]))

(defn- fresh-store []
  (let [st (store/mem-store)]
    (store/register-client! st {:client-id "client-1" :name "Kobo Trade"})
    (store/register-site! st {:site-id "S-1" :client-id "client-1"
                              :name "public-portal"
                              :min-conformance-level :aa
                              :approved-domains #{"portal.example.org"}})
    st))

(defn- deploy [level domain]
  {:op :approve-deployment :effect :propose :site-id "S-1"
   :achieved-conformance-level level :domain domain :confidence 0.9 :stake :low})

(def ^:private req {:client-id "client-1"})

(deftest ok-at-required-level-and-approved-domain
  (let [st (fresh-store)
        v (governor/check req {} (deploy :aa "portal.example.org") st)]
    (is (:ok? v))))

(deftest ok-above-required-level
  (testing "AAA exceeds a required AA floor and remains conforming"
    (let [st (fresh-store)
          v (governor/check req {} (deploy :aaa "portal.example.org") st)]
      (is (:ok? v)))))

(deftest hard-on-below-conformance-floor
  (testing "conformance is an ordinal scale, not aspirational"
    (let [st (fresh-store)
          v (governor/check req {} (assoc (deploy :a "portal.example.org") :confidence 0.99) st)]
      (is (:hard? v))
      (is (some #(= :conformance-below-floor (:rule %)) (:violations v))))))

(deftest hard-on-unapproved-domain
  (let [st (fresh-store)
        v (governor/check req {} (deploy :aa "shadow-site.example.net") st)]
    (is (:hard? v))
    (is (some #(= :unapproved-domain (:rule %)) (:violations v)))))

(deftest hard-on-unknown-site
  (let [st (fresh-store)
        v (governor/check req {} (assoc (deploy :aa "portal.example.org") :site-id "S-ghost") st)]
    (is (:hard? v))
    (is (some #(= :unknown-site (:rule %)) (:violations v)))))

(deftest hard-on-foreign-site
  (let [st (fresh-store)]
    (store/register-client! st {:client-id "client-2" :name "Other"})
    (let [v (governor/check {:client-id "client-2"} {} (deploy :aa "portal.example.org") st)]
      (is (:hard? v))
      (is (some #(= :site-wrong-client (:rule %)) (:violations v))))))

(deftest hard-on-unregistered-client
  (let [st (fresh-store)
        v (governor/check {:client-id "nobody"} {} (deploy :aa "portal.example.org") st)]
    (is (:hard? v))
    (is (some #(= :no-client (:rule %)) (:violations v)))))

(deftest hard-on-no-actuation-violation
  (let [st (fresh-store)
        v (governor/check req {} (assoc (deploy :aa "portal.example.org") :effect :direct-write) st)]
    (is (:hard? v))
    (is (some #(= :no-actuation (:rule %)) (:violations v)))))

(deftest escalates-production-cutover
  (let [st (fresh-store)
        v (governor/check req {} {:op :approve-production-cutover :effect :propose
                                  :site-id "S-1" :confidence 0.9 :stake :high} st)]
    (is (not (:hard? v)))
    (is (:escalate? v))))

(deftest escalates-low-confidence
  (let [st (fresh-store)
        v (governor/check req {} (assoc (deploy :aa "portal.example.org") :confidence 0.3) st)]
    (is (not (:hard? v)))
    (is (:escalate? v))))
